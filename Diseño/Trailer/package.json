{
  "name": "pokerush-trailer",
  "version": "1.0.0",
  "description": "Tráiler de PokeRush (Remotion)",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.532",
    "@remotion/fonts": "4.0.532",
    "@remotion/media": "4.0.532",
    "@remotion/media-utils": "4.0.532",
    "@remotion/motion-blur": "4.0.532",
    "@remotion/noise": "4.0.532",
    "@remotion/studio": "4.0.532",
    "@remotion/transitions": "4.0.532",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.532"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.532",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.39.5",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "assets": "node scripts/copiar-assets.mjs",
    "beats": ".venv\\Scripts\\python.exe scripts/detectar-beats.py",
    "voz": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generar-voz.ps1",
    "stills": "node scripts/stills.mjs",
    "render": "remotion render Trailer out/PokeRush_Trailer_sin_normalizar.mp4 --codec=h264 --crf=16 --audio-codec=aac --audio-bitrate=320k",
    "normalizar": "node scripts/normalizar.mjs out/PokeRush_Trailer_sin_normalizar.mp4 out/PokeRush_Trailer.mp4",
    "final": "npm run render && npm run normalizar"
  }
}
