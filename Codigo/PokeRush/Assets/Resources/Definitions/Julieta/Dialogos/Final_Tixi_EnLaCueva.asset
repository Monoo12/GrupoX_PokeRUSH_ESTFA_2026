  m_Script: {fileID: 11500000, guid: a0f91ab8d2ed2e846b7d97bd368fc013, type: 3}
  m_Name: Final_Tixi_EnLaCueva
  m_EditorClassIdentifier: Assembly-CSharp::DialogueDefinition
  speakerName: TIXI
  speakerPortrait: {fileID: 21300000, guid: 29f022df382dcbf47a02f8d6628d92f5, type: 3}
  lines:
  - "[] Tixi est\xE1 frente a las computadoras."
  - "[TIXI] \xBFLo hiciste?"
  - "[PJ] S\xED."
  - "[TIXI] \xBFY Julieta?"
  - "[PJ] Est\xE1 viva."
  - "[TIXI] \xBFLa desconectaste?"
  - "[PJ] S\xED."
  - "[] Tixi se queda mir\xE1ndote."
  - "[TIXI] Entonces termin\xF3."
  - '[PJ] Eso parece.'
  - "[TIXI] \xBFRecordaste algo?"
  - '[PJ] No.'
  - "[TIXI] \xBFNada?"
  - '[PJ] Algunas cosas.'
  - "[TIXI] \xBFQu\xE9 cosas?"
  - '[PJ] La sala.'
  - '[] Tixi deja de mirar la computadora.'
  - "[TIXI] \xBFLa sala de 2026?"
  - "[PJ] S\xED."
  - "[TIXI] \xBFY qu\xE9 record\xE1s?"
  - "[PJ] Que vos estabas ah\xED."
  - '[] Tixi no se mueve.'
  - '[PJ] No te preocupes.'
  - "[TIXI] \xBFNo te enojaste?"
  - "[PJ] Todav\xEDa no."
  - "[TIXI] \xBFTodav\xEDa?"
  - "[PJ] Primero quiero saber qu\xE9 pas\xF3 realmente."
  - '[TIXI] Entonces tenemos trabajo.'
  - "[PJ] Pens\xE9 que esto hab\xEDa terminado."
  - "[TIXI] La parte del NeuraRush-LINK, s\xED."
  - "[TIXI] Pero ahora tenemos cinco a\xF1os de informaci\xF3n perdida, miles de
    personas intentando recuperar sus recuerdos..."
  - '[] Tixi mira las computadoras.'
  - "[TIXI] Y una historia que nadie cont\xF3 completa."
  - "[PJ] \xBFEso significa que vamos a seguir?"
  - "[TIXI] No s\xE9."
  - "[PJ] \xBFNo sab\xE9s?"
  - '[TIXI] Por primera vez en mucho tiempo...'
  - "[] Tixi sonr\xEDe."
  - '[TIXI] Podemos decidir nosotros.'
  - "[PJ] Me gusta c\xF3mo suena eso."
  - "[] Te sent\xE1s frente a una de las computadoras."
  - '[PJ] Bueno.'
  - "[PJ] \xBFPor d\xF3nde empezamos?"
  - '[TIXI] Por 2026.'
  - '[] La pantalla se enciende.'
  - '[SISTEMA] ARCHIVOS RECUPERADOS. PROYECTO: NEURARUSH-LINK. ESTADO: ARCHIVO INCOMPLETO.'
  - "[PJ] Parece que todav\xEDa quedan cosas por descubrir."
  - '[TIXI] Bastantes...'
