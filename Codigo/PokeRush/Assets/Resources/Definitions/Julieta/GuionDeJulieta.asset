%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 02515f7f930ba3147af4ae35fd4de551, type: 3}
  m_Name: GuionDeJulieta
  m_EditorClassIdentifier: Assembly-CSharp::GuionDeJulieta
  nombreJulieta: JULIETA
  nombreNestor: "N\xC9STOR"
  nombreTixi: TIXI
  retratoJulieta: {fileID: 21300000, guid: 7e8dce24e0e8c7d42bf0cec1efd2c72d, type: 3}
  retratoNestor: {fileID: 21300000, guid: 0f1798d60322fc14596167ce820d37b1, type: 3}
  retratoTixi: {fileID: 21300000, guid: 29f022df382dcbf47a02f8d6628d92f5, type: 3}
  retratoPJVaron: {fileID: 8673283512139689658, guid: eca01f3401e93744f9cd142adb0750b9, type: 3}
  retratoPJMujer: {fileID: 8673283512139689658, guid: 5ca8ccf995d05b04195d663ed0f1c411, type: 3}
  alEncontrarla:
  - hablante: 3
    texto: "En el centro de la sala est\xE1 el servidor principal, conectado a cientos
      de cables que recorren las paredes."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 3
    texto: "Frente a \xE9l est\xE1 Julieta."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: Llegaste.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: "\xBFEsperabas que viniera?"
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "Despu\xE9s de todo lo que hiciste, era cuesti\xF3n de tiempo."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: "Destru\xED tus servidores."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "Lo s\xE9."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: "Desconect\xE9 a tus guardianes."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "Tambi\xE9n lo s\xE9."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: Y ahora voy a destruir este.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "Se ve que pensar no es lo tuyo... \xBFDe verdad pens\xE1s que es tan
      sencillo?"
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 3
    texto: Julieta se da vuelta y observa el servidor.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "\xBFSab\xE9s cu\xE1ntas personas dependen de esto?"
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: Demasiadas.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "\xBFY sab\xE9s qu\xE9 pasar\xEDa si lo destruyeras?"
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: No me interesa.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "Claro que no. Nunca te interes\xF3 entender lo que hicimos."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: "Entonces explic\xE1melo."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 3
    texto: Julieta se queda en silencio unos segundos.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "Est\xE1 bien. Pero primero vas a tener que demostrarme que realmente
      merec\xE9s estar ac\xE1."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: "\xBFY c\xF3mo pens\xE1s hacer eso?"
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: De la misma forma que siempre.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 3
    texto: Julieta se pone frente a vos.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: Peleando.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: Por fin.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  alReintentar:
  - hablante: 0
    texto: Volviste.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "Bien. Demostrame que esta vez s\xED merec\xE9s estar ac\xE1."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  momentos:
  - nombre: 'Inicio: Nestor y la ruleta en linea'
    fase: 0
    cualquierFase: 0
    cuando:
    - cuando: 0
      valor: 0
    lineas:
    - hablante: 3
      texto: "PROTOCOLO N\xC9STOR: EN L\xCDNEA."
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 4
      parametro: 0
    - hablante: 2
      texto: "{PJ}, estoy conectado. Yo le leo las jugadas, vos peg\xE1."
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 3
      texto: "RULETA DE REYMAR: EN L\xCDNEA. JUEGA A FAVOR DE {PJ}."
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 2
      parametro: 1
    - hablante: 0
      texto: "N\xE9stor en tu o\xEDdo y la ruleta de Reymar en el bolsillo. Qu\xE9
        bien equipado ven\xEDs."
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 11
      parametro: 0
    - hablante: 0
      texto: Adelante. Yo solo voy a mirar.
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 0
      parametro: 0
  - nombre: 'F1: primera lectura de Nestor'
    fase: 0
    cualquierFase: 0
    cuando:
    - cuando: 7
      valor: 1
    lineas:
    - hablante: 0
      texto: "Ah\xED est\xE1. El Protocolo N\xE9stor."
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 0
      texto: "Ve la jugada antes de que pase, \xBFno? Qu\xE9 curioso. As\xED pienso
        yo."
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 2
      texto: "No la escuches, {PJ}. Segu\xED."
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 0
      parametro: 0
  - nombre: 'F1: primer giro de la ruleta'
    fase: 0
    cualquierFase: 0
    cuando:
    - cuando: 8
      valor: 1
    lineas:
    - hablante: 0
      texto: "La ruleta de Reymar. Te la dio cuando lo desconectaste, \xBFno?"
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 0
      texto: "Un generador de n\xFAmeros al azar. Qu\xE9 nombre lindo para algo que
        no existe."
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 0
      parametro: 0
  - nombre: 'F1: Julieta pierde el primero'
    fase: 0
    cualquierFase: 0
    cuando:
    - cuando: 3
      valor: 5
    lineas:
    - hablante: 0
      texto: Golpe limpio. Lo anoto.
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 0
      texto: "Siempre fuiste as\xED en clase: r\xE1pido para romper cosas, lento
        para preguntarte por qu\xE9 funcionan."
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 0
      parametro: 0
  - nombre: 'F1: Julieta termina de estudiar'
    fase: 0
    cualquierFase: 0
    cuando:
    - cuando: 2
      valor: 3
    lineas:
    - hablante: 0
      texto: "Tres turnos. Ya s\xE9 cu\xE1nto tarda N\xE9stor en recalcular y cada
        cu\xE1nto gira la ruleta."
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 0
      texto: "\xBFSab\xE9s qu\xE9 es lo gracioso, {PJ}? Todo lo que te est\xE1 ayudando
        corre sobre mi red."
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 0
      parametro: 0
  - nombre: 'F1 -> F2: Julieta cambia las reglas'
    fase: 0
    cualquierFase: 0
    cuando:
    - cuando: 2
      valor: 5
    - cuando: 3
      valor: 4
    - cuando: 12
      valor: 0
    lineas:
    - hablante: 0
      texto: "Suficiente. Ya entend\xED c\xF3mo pele\xE1s."
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 0
      texto: "Ahora te explico yo c\xF3mo funciona esto."
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 13
      parametro: 0
    - hablante: 3
      texto: 'NEURARUSH-LINK: ACCESO DE ADMINISTRADORA CONCEDIDO.'
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 12
      parametro: 1
    - hablante: 2
      texto: "\xA1{PJ}! Se meti\xF3 en el canal... no... no la puedo sacar..."
      retrato: {fileID: 21300000, guid: a4969c809e8096346880bff78dd80c5e, type: 3}
      sonido: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 3
      texto: "PROTOCOLO N\xC9STOR: CONEXI\xD3N PERDIDA."
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 5
      parametro: 0
    - hablante: 0
      texto: "El Protocolo N\xE9stor es una funci\xF3n de mi NeuraRush-LINK. N\xE9stor
        la usaba porque yo se la di."
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 0
      texto: "Ahora lee tus jugadas. Para m\xED."
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 6
      parametro: 0
    - hablante: 3
      texto: 'RULETA DE REYMAR: PREMIOS REASIGNADOS. JUEGA A FAVOR DE: JULIETA.'
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 2
      parametro: 2
    - hablante: 0
      texto: "Y la ruleta... Reymar la giraba. Yo cambi\xE9 los permisos."
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 11
      parametro: 1
    - hablante: 0
      texto: La casa siempre gana, {PJ}. Y la casa soy yo.
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 1
      parametro: 1
  - nombre: 'F2: primer giro dado vuelta'
    fase: 1
    cualquierFase: 0
    cuando:
    - cuando: 8
      valor: 1
    lineas:
    - hablante: 0
      texto: "\xBFLo ves? Los mismos n\xFAmeros, la misma rueda. Lo \xFAnico que
        cambi\xF3 es para qui\xE9n juega."
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 0
      texto: "Eso es el azar, {PJ}: una regla que todav\xEDa nadie te cont\xF3."
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 0
      parametro: 0
  - nombre: 'F2: 2026'
    fase: 1
    cualquierFase: 0
    cuando:
    - cuando: 2
      valor: 2
    lineas:
    - hablante: 0
      texto: "\xBFTe acord\xE1s de la oficina de la directora? El d\xEDa de la graduaci\xF3n."
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 1
      texto: "Estaba ah\xED. Vi el portal, a Mewtwo, a Hoopa... y a vos tir\xE1ndoles
        el LINK."
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 0
      texto: "Viste el final. \xBFY de lo que pas\xF3 antes en esa sala, qu\xE9 te
        acord\xE1s?"
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 1
      texto: "...\xBFQu\xE9 pas\xF3 antes?"
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 0
      texto: Ganame y te lo cuento.
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 0
      parametro: 0
  - nombre: 'F2: Julieta pierde otro'
    fase: 1
    cualquierFase: 0
    cuando:
    - cuando: 3
      valor: 3
    lineas:
    - hablante: 0
      texto: "Segu\xEDs pegando fuerte. Pero ya no est\xE1s peleando contra mis Pok\xE9mon."
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 0
      texto: "Est\xE1s peleando contra las reglas. Y las reglas son m\xEDas."
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 0
      parametro: 0
  - nombre: 'F2: el jugador pierde uno'
    fase: 1
    cualquierFase: 0
    cuando:
    - cuando: 6
      valor: 1
    lineas:
    - hablante: 0
      texto: "Uno menos. En 2026 la red colaps\xF3 en un segundo. Tu equipo va a
        tardar un poco m\xE1s."
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 0
      parametro: 0
  - nombre: 'F2 -> F3: Julieta entra al vinculo'
    fase: 1
    cualquierFase: 0
    cuando:
    - cuando: 2
      valor: 5
    - cuando: 3
      valor: 2
    - cuando: 12
      valor: 0
    lineas:
    - hablante: 0
      texto: "Te voy a mostrar para qu\xE9 sirve de verdad el NeuraRush-LINK."
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 0
      texto: "Conecta. Personas, m\xE1quinas... Pok\xE9mon."
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 0
      texto: "Y un Pok\xE9mon conectado escucha a quien tiene la red."
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 13
      parametro: 0
    - hablante: 3
      texto: 'NEURARUSH-LINK: ACCEDIENDO A {POKEMON}...'
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 8
      parametro: 0
    - hablante: 1
      texto: "\xA1{POKEMON}! \xA1Soy yo!"
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 10
      parametro: 1
    - hablante: 0
      texto: Sigue en tu equipo. Sigue teniendo tu nombre en la ficha. Pero ya no
        te escucha.
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 0
      texto: "Ahora no alcanza con ganarme, {PJ}. Ten\xE9s que sobrevivirte."
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 1
      parametro: 2
  - nombre: 'F3: primer golpe al PJ'
    fase: 2
    cualquierFase: 0
    cuando:
    - cuando: 10
      valor: 1
    lineas:
    - hablante: 1
      texto: "\xA1Agh...! \xA1{POKEMON}, par\xE1!"
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 0
      texto: "Duele porque es tuyo. Para eso sirve un v\xEDnculo."
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 0
      parametro: 0
  - nombre: 'F3: Tacconi y el registro'
    fase: 2
    cualquierFase: 0
    cuando:
    - cuando: 2
      valor: 2
    lineas:
    - hablante: 1
      texto: "Tacconi encontr\xF3 mi nombre en un registro de 2026. El del primer
        experimento del LINK."
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 1
      texto: Dijo que yo no era uno de los sujetos. Que era parte del desarrollo.
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 0
      texto: "Tacconi siempre ley\xF3 de m\xE1s."
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 0
      texto: "Pero esta vez ley\xF3 bien."
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 0
      parametro: 0
  - nombre: 'F3: el PJ se da cuenta'
    fase: 2
    cualquierFase: 0
    cuando:
    - cuando: 9
      valor: 60
    lineas:
    - hablante: 1
      texto: "Si lo dejo en el campo me va a terminar... Tengo que sacarlo. O terminar
        esto r\xE1pido."
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 0
      parametro: 0
  - nombre: 'F3: el PJ al limite'
    fase: 2
    cualquierFase: 0
    cuando:
    - cuando: 9
      valor: 30
    lineas:
    - hablante: 0
      texto: "Mirate, {PJ}. Cinco a\xF1os esquivando el chip, y te tira abajo tu
        propio equipo."
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 0
      parametro: 0
  - nombre: 'F3: el controlado cayo'
    fase: 2
    cualquierFase: 0
    cuando:
    - cuando: 11
      valor: 0
    lineas:
    - hablante: 0
      texto: "Uno menos. No importa: tu equipo tiene m\xE1s puertas."
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 3
      texto: 'NEURARUSH-LINK: ACCEDIENDO A {POKEMON}...'
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 8
      parametro: 0
  - nombre: 'F3: el ultimo de Julieta'
    fase: 2
    cualquierFase: 0
    cuando:
    - cuando: 5
      valor: 0
    lineas:
    - hablante: 0
      texto: "Me queda uno. Y mientras la red sea m\xEDa, no cae."
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 0
      parametro: 0
  - nombre: 'F3 -> Ruptura: Tixi abre la red'
    fase: 2
    cualquierFase: 0
    cuando:
    - cuando: 2
      valor: 5
    - cuando: 12
      valor: 0
    lineas:
    - hablante: 0
      texto: "\xBFVes, {PJ}? As\xED se ve una red cuando tiene due\xF1a."
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 3
      texto: 'TRANSMISOR EXTERNO DETECTADO. ORIGEN: DESCONOCIDO.'
      retrato: {fileID: 0}
      sonido: {fileID: 8300000, guid: 18ccca17fc1978044bec67f47023d9c0, type: 3}
      accion: 13
      parametro: 0
    - hablante: 4
      texto: "\xA1{PJ}! \xA1Entr\xE9! El transmisor me abri\xF3 una puerta en la
        red. No s\xE9 cu\xE1nto la puedo sostener."
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 0
      texto: "\xBFQui\xE9n m\xE1s est\xE1 en mi red?"
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 4
      texto: 'El chip nunca te pudo escribir, {PJ}. Hablale a {POKEMON} por el LINK:
        a vos te va a escuchar.'
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 1
      texto: "{POKEMON}... soy yo. Volv\xE9."
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 13
      parametro: 0
    - hablante: 3
      texto: "V\xCDNCULO LIBERADO."
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 9
      parametro: 0
    - hablante: 3
      texto: 'LECTURA DE LA ADMINISTRADORA: REVOCADA.'
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 7
      parametro: 0
    - hablante: 3
      texto: "PROTOCOLO N\xC9STOR: EN L\xCDNEA."
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 4
      parametro: 0
    - hablante: 2
      texto: "\xA1{PJ}! \xA1Volv\xED! Alguien abri\xF3 el canal de nuevo."
      retrato: {fileID: 21300000, guid: 853498d5f00c6fa45a5a2b62a53fa1c5, type: 3}
      sonido: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 3
      texto: 'RULETA DE REYMAR: JUEGA A FAVOR DE {PJ}.'
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 2
      parametro: 1
    - hablante: 0
      texto: No... esto no estaba en el plan.
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 12
      parametro: 0
    - hablante: 4
      texto: "Ya est\xE1. Terminalo, {PJ}."
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 1
      texto: Estoy bien. Sigo en pie.
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 10
      parametro: 0
    - hablante: 1
      texto: "Ahora s\xED, profe. Terminemos."
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 1
      parametro: 3
  - nombre: 'Ruptura: el ultimo de Julieta'
    fase: 3
    cualquierFase: 0
    cuando:
    - cuando: 5
      valor: 0
    lineas:
    - hablante: 0
      texto: Me queda uno, {PJ}. Y no lo pienso soltar.
      retrato: {fileID: 0}
      sonido: {fileID: 0}
      accion: 0
      parametro: 0
  - nombre: 'Ruptura: Nestor acompana'
    fase: 3
    cualquierFase: 0
    cuando:
    - cuando: 2
      valor: 2
    lineas:
    - hablante: 2
      texto: "Ella nunca perdi\xF3 un turno en su vida, {PJ}. Que este sea el primero."
      retrato: {fileID: 21300000, guid: 8ce26824c4e18f74aa1d4a5ea277d149, type: 3}
      sonido: {fileID: 0}
      accion: 0
      parametro: 0
  alPerder:
  - hablante: 0
    texto: "Esto es lo que te quer\xEDa mostrar, {PJ}. Sin mis reglas no hay juego."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "Tu equipo vuelve a como entr\xF3. No me sirve de nada ganarle a alguien
      roto."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "Cuando quieras, volv\xE9 a intentarlo. Yo no me voy a ning\xFAn lado."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  finalDelJuego:
  - hablante: 3
    texto: "El \xFAltimo Pok\xE9mon de Julieta cae. Ella se queda de pie unos segundos..."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 3
    texto: ...y finalmente cae de rodillas.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: "Se termin\xF3."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: No...
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: "S\xED."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "Si destru\xEDs ese servidor, todo va a terminar."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: Eso es exactamente lo que vine a hacer.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "No entend\xE9s lo que est\xE1s haciendo."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: "Entonces explic\xE1melo."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 3
    texto: "Julieta mira hacia el servidor principal, que sigue encendido detr\xE1s
      de ella."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  enElServidor:
  - hablante: 0
    texto: El NeuraRush-LINK no fue creado para controlar personas.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: "\xBFEntonces para qu\xE9?"
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: Para conectar.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: "\xBFConectar qu\xE9?"
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "Personas. M\xE1quinas. Pok\xE9mon. Todo."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: Y para hacer eso destruyeron la vida de miles de personas.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: Fue un accidente.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: "\xBFUn accidente que dur\xF3 cinco a\xF1os?"
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "Despu\xE9s de 2026 ya no hab\xEDa vuelta atr\xE1s."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: "Siempre hubo una vuelta atr\xE1s."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: No.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 3
    texto: Julieta te mira.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: Vos sos la prueba de eso.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: "\xBFQu\xE9 quer\xE9s decir?"
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: Vos sobreviviste sin modificaciones. Sin estabilizadores. Sin depender
      del chip.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: Eso ya me lo dijo Reymar.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "Reymar no sab\xEDa todo."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: Entonces decime.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "Cuando comenzamos los primeros experimentos, necesit\xE1bamos encontrar
      una forma de conectar un cerebro humano al sistema..."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: ...sin destruirlo.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: Y me usaron para eso.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: Te estudiamos.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: "\xBFSin que yo lo supiera?"
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "Eras el \xFAnico caso que funcionaba."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: "\xBFY qu\xE9 pas\xF3 despu\xE9s?"
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: El accidente.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: "\xBFY despu\xE9s?"
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "Despu\xE9s intentamos controlar lo que hab\xEDamos creado."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: Y terminaron conectando a todo el mundo.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: No exactamente.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: "\xBFQu\xE9 significa eso?"
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "El NeuraRush-LINK no oblig\xF3 a todos a conectarse."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: "\xBFEntonces?"
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "Una vez que comenz\xF3 a expandirse, las personas empezaron a conectarse
      voluntariamente."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: "\xBFPor qu\xE9?"
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "Porque pod\xEDan hacer cosas que antes eran imposibles."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: Compartir conocimientos.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: Comunicarse sin hablar.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: Aprender en segundos.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "Incluso conectar sus pensamientos con Pok\xE9mon."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: "Y tambi\xE9n perdieron sus recuerdos."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: Algunos.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: Se convirtieron en otra cosa.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: Tal vez.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: Entonces todo esto...
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: Es el resultado de intentar solucionar un problema que nosotros mismos
      creamos.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 3
    texto: Silencio.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  alDestruirlo:
  - hablante: 1
    texto: "No importa cu\xE1nto intentes justificarlo."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: "Hay gente que perdi\xF3 cinco a\xF1os de su vida."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "Lo s\xE9."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: "Entonces se termin\xF3."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "Si destru\xEDs el servidor, tambi\xE9n vas a destruir toda la red."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: Tixi dijo lo mismo.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "\xBFTixi?"
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: "S\xED."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "Entonces finalmente te encontr\xF3."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: "\xBFConoc\xEDas a Tixi?"
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "Todos los que trabajamos en el proyecto conoc\xEDamos su trabajo."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: "\xBFTixi tambi\xE9n estuvo en el proyecto?"
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: No como vos.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: "\xBFQu\xE9 significa eso?"
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "Que intent\xF3 detenernos antes del accidente."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: "\xBFY por qu\xE9 nunca me lo cont\xF3?"
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "Porque probablemente ten\xEDa miedo de que recordaras."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: "\xBFRecordar qu\xE9?"
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "Lo que pas\xF3 en aquella sala."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 3
    texto: "Te qued\xE1s en silencio."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: "\xBFQu\xE9 pas\xF3?"
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "Vos estabas ah\xED cuando comenz\xF3 todo."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: Yo...
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "Y viste c\xF3mo empez\xF3 el primer experimento."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: No recuerdo nada.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "Por eso sos el \xFAnico que todav\xEDa puede decidir qu\xE9 hacer con
      esto."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: "\xBFQu\xE9 quer\xE9s decir?"
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "Si destru\xEDs el servidor, nadie podr\xE1 volver a utilizar el NeuraRush-LINK."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: Entonces lo voy a destruir.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: Pero tampoco vas a poder recuperar tus propios recuerdos.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 3
    texto: "Mir\xE1s el servidor."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: "Ya perd\xED cinco a\xF1os."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: No voy a perder el resto de mi vida intentando recuperarlos.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: ...
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: "Se termin\xF3, Julieta."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 3
    texto: "Te acerc\xE1s al servidor principal."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "Esper\xE1."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: "\xBFQu\xE9?"
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "Quiz\xE1s alg\xFAn d\xEDa entiendas por qu\xE9 lo hicimos."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: "Quiz\xE1s."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: Pero no va a ser con esto conectado.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 3
    texto: "Destru\xEDs el n\xFAcleo del servidor."
    retrato: {fileID: 0}
    sonido: {fileID: 8300000, guid: b392e0f5ab093224f85209def7f74dbc, type: 3}
    accion: 14
    parametro: 0
  - hablante: 3
    texto: ADVERTENCIA. SERVIDOR PRINCIPAL DESTRUIDO.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 3
    texto: "CONEXI\xD3N CON NEURARUSH-LINK INTERRUMPIDA. DESCONEXI\xD3N GLOBAL INICIADA."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 3
    texto: "Las luces de la sala comienzan a apagarse. Los cables que recorren las
      paredes dejan de emitir energ\xEDa."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 3
    texto: Julieta observa el servidor destruido.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  conJulietaEnElSuelo:
  - hablante: 0
    texto: "Cinco a\xF1os..."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: "S\xED."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: Todo este tiempo...
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: "Se termin\xF3."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 3
    texto: El NeuraRush-LINK de Julieta comienza a emitir pulsos.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 13
    parametro: 0
  - hablante: 3
    texto: "ERROR CR\xCDTICO. CONEXI\xD3N PERDIDA. DESCONEXI\xD3N INICIADA."
    retrato: {fileID: 0}
    sonido: {fileID: 8300000, guid: 89c1cf6d8cdc93f42b880d8f99168bd1, type: 3}
    accion: 0
    parametro: 0
  - hablante: 3
    texto: El chip de Julieta se apaga. Julieta cae al suelo.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: Julieta.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: ...
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: "\xBFEst\xE1s bien?"
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "No s\xE9."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 3
    texto: Julieta se mira las manos.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "\xBFQu\xE9 a\xF1o es?"
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: 2031.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 3
    texto: Julieta cierra los ojos.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "Entonces funcion\xF3."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: "\xBFQu\xE9 cosa?"
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "Por primera vez en cinco a\xF1os..."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: Estoy sola en mi propia cabeza.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 3
    texto: "No le respond\xE9s."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "\xBFQu\xE9 vas a hacer ahora?"
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: No tengo idea.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "\xBFY Tixi?"
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: "Esper\xE1ndome."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "Entonces and\xE1."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: "\xBFY vos?"
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 3
    texto: Julieta mira el servidor destruido.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: Yo tengo mucho que recordar.
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 3
    texto: "Te das vuelta y empez\xE1s a caminar hacia la salida."
    retrato: {fileID: 0}
    sonido: {fileID: 0}
    accion: 0
    parametro: 0
  yaVencida:
