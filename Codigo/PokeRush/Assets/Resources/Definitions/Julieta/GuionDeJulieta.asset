%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 02515f7f930ba3147af4ae35fd4de551, type: 3}
  m_Name: GuionDeJulieta
  m_EditorClassIdentifier: Assembly-CSharp::GuionDeJulieta
  nombreJulieta: JULIETA
  nombreNestor: "N\xC9STOR"
  retratoJulieta: {fileID: 21300000, guid: 22d8f055d00cd634198beecdcbe1c195, type: 3}
  retratoNestor: {fileID: 21300000, guid: 0f1798d60322fc14596167ce820d37b1, type: 3}
  retratoPJVaron: {fileID: 8673283512139689658, guid: eca01f3401e93744f9cd142adb0750b9, type: 3}
  retratoPJMujer: {fileID: 8673283512139689658, guid: 5ca8ccf995d05b04195d663ed0f1c411, type: 3}
  alEncontrarla:
  - hablante: 3
    texto: SERVIDOR CENTRAL DE NEURARUSH-LINK. USUARIO SIN REGISTRAR EN LA SALA.
    retrato: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: Llegaste, {PJ}. Tarde, como siempre. Pero llegaste.
    retrato: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: Julieta.
    retrato: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: Profesora Julieta. Que el mundo se haya dado vuelta no es excusa para
      perder los modales.
    retrato: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: Vengo a apagar todo esto.
    retrato: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "Ya s\xE9. Apagaste mis servidores uno por uno, desconectaste a N\xE9stor,
      te llevaste el casino de Mart\xEDn."
    retrato: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "Mewtwo y Hoopa tambi\xE9n est\xE1n ac\xE1. Vinieron en 2026 a detenerme,
      \xBFte acord\xE1s? Ahora pelean para m\xED."
    retrato: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "Ven\xED. Mostrame lo que aprendiste. Quiero ver con qu\xE9 me vas a enfrentar."
    retrato: {fileID: 0}
    accion: 0
    parametro: 0
  momentos:
  - nombre: 'Inicio: Nestor y la ruleta en linea'
    fase: 0
    cualquierFase: 0
    cuando:
    - cuando: 0
      valor: 0
    lineas:
    - hablante: 3
      texto: "PROTOCOLO N\xC9STOR: EN L\xCDNEA."
      retrato: {fileID: 0}
      accion: 4
      parametro: 0
    - hablante: 2
      texto: "{PJ}, estoy conectado. Yo le leo las jugadas, vos peg\xE1."
      retrato: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 3
      texto: "RULETA DE MART\xCDN: EN L\xCDNEA. JUEGA A FAVOR DE {PJ}."
      retrato: {fileID: 0}
      accion: 2
      parametro: 1
    - hablante: 0
      texto: "N\xE9stor en tu o\xEDdo y la ruleta de Mart\xEDn en el bolsillo. Qu\xE9
        bien equipado ven\xEDs."
      retrato: {fileID: 0}
      accion: 11
      parametro: 0
    - hablante: 0
      texto: Adelante. Yo solo voy a mirar.
      retrato: {fileID: 0}
      accion: 0
      parametro: 0
  - nombre: 'F1: primera lectura de Nestor'
    fase: 0
    cualquierFase: 0
    cuando:
    - cuando: 7
      valor: 1
    lineas:
    - hablante: 0
      texto: "Ah\xED est\xE1. El Protocolo N\xE9stor."
      retrato: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 0
      texto: "Ve la jugada antes de que pase, \xBFno? Qu\xE9 curioso. As\xED pienso
        yo."
      retrato: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 2
      texto: "No la escuches, {PJ}. Segu\xED."
      retrato: {fileID: 0}
      accion: 0
      parametro: 0
  - nombre: 'F1: primer giro de la ruleta'
    fase: 0
    cualquierFase: 0
    cuando:
    - cuando: 8
      valor: 1
    lineas:
    - hablante: 0
      texto: "La ruleta de Mart\xEDn. Te la dio cuando lo desconectaste, \xBFno?"
      retrato: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 0
      texto: "Un generador de n\xFAmeros al azar. Qu\xE9 nombre lindo para algo que
        no existe."
      retrato: {fileID: 0}
      accion: 0
      parametro: 0
  - nombre: 'F1: Julieta pierde el primero'
    fase: 0
    cualquierFase: 0
    cuando:
    - cuando: 3
      valor: 5
    lineas:
    - hablante: 0
      texto: Golpe limpio. Lo anoto.
      retrato: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 0
      texto: "Siempre fuiste as\xED en clase: r\xE1pido para romper cosas, lento
        para preguntarte por qu\xE9 funcionan."
      retrato: {fileID: 0}
      accion: 0
      parametro: 0
  - nombre: 'F1: Julieta termina de estudiar'
    fase: 0
    cualquierFase: 0
    cuando:
    - cuando: 2
      valor: 3
    lineas:
    - hablante: 0
      texto: "Tres turnos. Ya s\xE9 cu\xE1nto tarda N\xE9stor en recalcular y cada
        cu\xE1nto gira la ruleta."
      retrato: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 0
      texto: "\xBFSab\xE9s qu\xE9 es lo gracioso, {PJ}? Todo lo que te est\xE1 ayudando
        sali\xF3 de mi c\xF3digo."
      retrato: {fileID: 0}
      accion: 0
      parametro: 0
  - nombre: 'F1 -> F2: Julieta cambia las reglas'
    fase: 0
    cualquierFase: 0
    cuando:
    - cuando: 2
      valor: 5
    - cuando: 3
      valor: 4
    - cuando: 12
      valor: 0
    lineas:
    - hablante: 0
      texto: "Suficiente. Ya entend\xED c\xF3mo pele\xE1s."
      retrato: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 0
      texto: "Ahora te explico yo c\xF3mo funciona esto."
      retrato: {fileID: 0}
      accion: 13
      parametro: 0
    - hablante: 3
      texto: 'NEURARUSH-LINK: ACCESO DE ADMINISTRADORA CONCEDIDO.'
      retrato: {fileID: 0}
      accion: 12
      parametro: 1
    - hablante: 2
      texto: "\xA1{PJ}! Se meti\xF3 en el canal... no... no la puedo sacar..."
      retrato: {fileID: 21300000, guid: a4969c809e8096346880bff78dd80c5e, type: 3}
      accion: 0
      parametro: 0
    - hablante: 3
      texto: "PROTOCOLO N\xC9STOR: CONEXI\xD3N PERDIDA."
      retrato: {fileID: 0}
      accion: 5
      parametro: 0
    - hablante: 0
      texto: "El Protocolo N\xE9stor lo escrib\xED yo. N\xE9stor aprendi\xF3 a leer
        una jugada porque yo le ense\xF1\xE9."
      retrato: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 0
      texto: "Ahora lee las tuyas. Para m\xED."
      retrato: {fileID: 0}
      accion: 6
      parametro: 0
    - hablante: 3
      texto: "RULETA DE MART\xCDN: PREMIOS REASIGNADOS. JUEGA A FAVOR DE: JULIETA."
      retrato: {fileID: 0}
      accion: 2
      parametro: 2
    - hablante: 0
      texto: "Y la ruleta... Mart\xEDn la giraba. Yo la program\xE9."
      retrato: {fileID: 0}
      accion: 11
      parametro: 1
    - hablante: 0
      texto: La casa siempre gana, {PJ}. Y la casa soy yo.
      retrato: {fileID: 0}
      accion: 1
      parametro: 1
  - nombre: 'F2: primer giro dado vuelta'
    fase: 1
    cualquierFase: 0
    cuando:
    - cuando: 8
      valor: 1
    lineas:
    - hablante: 0
      texto: "\xBFLo ves? Los mismos n\xFAmeros, la misma rueda. Lo \xFAnico que
        cambi\xF3 es para qui\xE9n juega."
      retrato: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 0
      texto: "Eso es el azar, {PJ}: una regla que todav\xEDa nadie te cont\xF3."
      retrato: {fileID: 0}
      accion: 0
      parametro: 0
  - nombre: 'F2: 2026'
    fase: 1
    cualquierFase: 0
    cuando:
    - cuando: 2
      valor: 2
    lineas:
    - hablante: 0
      texto: "\xBFTe acord\xE1s de la oficina de la directora? El d\xEDa de la graduaci\xF3n."
      retrato: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 1
      texto: "Estaba ah\xED. Lo vi todo."
      retrato: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 0
      texto: "Ya s\xE9 que estabas ah\xED. Escondido, esperando que la red se cayera
        para meter un virus que llevabas a\xF1os escribiendo."
      retrato: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 1
      texto: "...\xBFC\xF3mo sab\xE9s eso?"
      retrato: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 0
      texto: "Porque lo encontr\xE9 mucho antes de que vos pudieras usarlo."
      retrato: {fileID: 0}
      accion: 0
      parametro: 0
  - nombre: 'F2: Julieta pierde otro'
    fase: 1
    cualquierFase: 0
    cuando:
    - cuando: 3
      valor: 3
    lineas:
    - hablante: 0
      texto: "Segu\xEDs pegando fuerte. Pero ya no est\xE1s peleando contra mis Pok\xE9mon."
      retrato: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 0
      texto: "Est\xE1s peleando contra las reglas. Y las reglas son m\xEDas."
      retrato: {fileID: 0}
      accion: 0
      parametro: 0
  - nombre: 'F2: el jugador pierde uno'
    fase: 1
    cualquierFase: 0
    cuando:
    - cuando: 6
      valor: 1
    lineas:
    - hablante: 0
      texto: "Uno menos. En 2026 la red colaps\xF3 en un segundo. Tu equipo va a
        tardar un poco m\xE1s."
      retrato: {fileID: 0}
      accion: 0
      parametro: 0
  - nombre: 'F2 -> F3: Julieta entra al vinculo'
    fase: 1
    cualquierFase: 0
    cuando:
    - cuando: 2
      valor: 5
    - cuando: 3
      valor: 2
    - cuando: 12
      valor: 0
    lineas:
    - hablante: 0
      texto: "Te voy a mostrar para qu\xE9 sirve de verdad el NeuraRush-LINK."
      retrato: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 0
      texto: "No es para ense\xF1ar. Ense\xF1ar es lento: la gente se equivoca, se
        olvida, se rebela."
      retrato: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 0
      texto: "El LINK no ense\xF1a, {PJ}. Escribe. Escribe lo que ten\xE9s que saber...
        y borra lo que no."
      retrato: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 0
      texto: "Y un Pok\xE9mon es un v\xEDnculo. Un v\xEDnculo tambi\xE9n se puede
        escribir."
      retrato: {fileID: 0}
      accion: 13
      parametro: 0
    - hablante: 3
      texto: 'NEURARUSH-LINK: ACCEDIENDO A {POKEMON}...'
      retrato: {fileID: 0}
      accion: 8
      parametro: 0
    - hablante: 1
      texto: "\xA1{POKEMON}! \xA1Soy yo!"
      retrato: {fileID: 0}
      accion: 10
      parametro: 1
    - hablante: 0
      texto: Sigue en tu equipo. Sigue teniendo tu nombre en la ficha. Pero ya no
        te escucha.
      retrato: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 0
      texto: "Ahora no alcanza con ganarme, {PJ}. Ten\xE9s que sobrevivirte."
      retrato: {fileID: 0}
      accion: 1
      parametro: 2
  - nombre: 'F3: primer golpe al PJ'
    fase: 2
    cualquierFase: 0
    cuando:
    - cuando: 10
      valor: 1
    lineas:
    - hablante: 1
      texto: "\xA1Agh...! \xA1{POKEMON}, par\xE1!"
      retrato: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 0
      texto: "Duele porque es tuyo. Para eso sirve un v\xEDnculo."
      retrato: {fileID: 0}
      accion: 0
      parametro: 0
  - nombre: 'F3: Tacconi y el registro'
    fase: 2
    cualquierFase: 0
    cuando:
    - cuando: 2
      valor: 2
    lineas:
    - hablante: 1
      texto: "Tacconi encontr\xF3 mi nombre en un registro de 2026. El del primer
        experimento del LINK."
      retrato: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 1
      texto: Dijo que yo no era uno de los sujetos. Que era parte del desarrollo.
      retrato: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 0
      texto: "Tacconi siempre ley\xF3 de m\xE1s."
      retrato: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 0
      texto: "Pero esta vez ley\xF3 bien."
      retrato: {fileID: 0}
      accion: 0
      parametro: 0
  - nombre: 'F3: el PJ se da cuenta'
    fase: 2
    cualquierFase: 0
    cuando:
    - cuando: 9
      valor: 60
    lineas:
    - hablante: 1
      texto: "Si lo dejo en el campo me va a terminar... Tengo que sacarlo. O terminar
        esto r\xE1pido."
      retrato: {fileID: 0}
      accion: 0
      parametro: 0
  - nombre: 'F3: el PJ al limite'
    fase: 2
    cualquierFase: 0
    cuando:
    - cuando: 9
      valor: 30
    lineas:
    - hablante: 0
      texto: "Mirate, {PJ}. En 2026 quer\xEDas tirar abajo la red del colegio. Ahora
        la red te tira abajo a vos."
      retrato: {fileID: 0}
      accion: 0
      parametro: 0
  - nombre: 'F3: el controlado cayo'
    fase: 2
    cualquierFase: 0
    cuando:
    - cuando: 11
      valor: 0
    lineas:
    - hablante: 0
      texto: "Uno menos. No importa: tu equipo tiene m\xE1s puertas."
      retrato: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 3
      texto: 'NEURARUSH-LINK: ACCEDIENDO A {POKEMON}...'
      retrato: {fileID: 0}
      accion: 8
      parametro: 0
  - nombre: 'F3: el ultimo de Julieta'
    fase: 2
    cualquierFase: 0
    cuando:
    - cuando: 5
      valor: 0
    lineas:
    - hablante: 0
      texto: "Me queda uno. Y mientras el sistema sea m\xEDo, no cae."
      retrato: {fileID: 0}
      accion: 0
      parametro: 0
  - nombre: 'F3 -> Ruptura: el PJ rompe el control'
    fase: 2
    cualquierFase: 0
    cuando:
    - cuando: 2
      valor: 5
    - cuando: 12
      valor: 0
    lineas:
    - hablante: 0
      texto: "\xBFTodav\xEDa no lo entendiste? No eras un sujeto del experimento,
        {PJ}. Eras un autor."
      retrato: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 0
      texto: "Tu virus es lo que deja al LINK entrar en una cabeza sin pedir permiso.
        Lo encontr\xE9 en el servidor del colegio y lo us\xE9."
      retrato: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 1
      texto: Por eso el chip de mi nuca no me hace nada...
      retrato: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 0
      texto: "Un virus no infecta a quien lo escribi\xF3."
      retrato: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 1
      texto: "Entonces tu sistema tambi\xE9n me escucha a m\xED."
      retrato: {fileID: 0}
      accion: 0
      parametro: 0
    - hablante: 1
      texto: "{POKEMON}... soy yo. Este c\xF3digo es m\xEDo. \xA1Desconectate!"
      retrato: {fileID: 0}
      accion: 13
      parametro: 0
    - hablante: 3
      texto: "FIRMA DE AUTOR RECONOCIDA. V\xCDNCULO LIBERADO."
      retrato: {fileID: 0}
      accion: 9
      parametro: 0
    - hablante: 3
      texto: 'LECTURA DE LA ADMINISTRADORA: REVOCADA.'
      retrato: {fileID: 0}
      accion: 7
      parametro: 0
    - hablante: 3
      texto: "PROTOCOLO N\xC9STOR: EN L\xCDNEA."
      retrato: {fileID: 0}
      accion: 4
      parametro: 0
    - hablante: 2
      texto: "\xA1{PJ}! \xA1Volv\xED! Lo que hiciste abri\xF3 el canal de nuevo."
      retrato: {fileID: 21300000, guid: 853498d5f00c6fa45a5a2b62a53fa1c5, type: 3}
      accion: 0
      parametro: 0
    - hablante: 3
      texto: "RULETA DE MART\xCDN: JUEGA A FAVOR DE {PJ}."
      retrato: {fileID: 0}
      accion: 2
      parametro: 1
    - hablante: 0
      texto: No... esto no estaba en el plan.
      retrato: {fileID: 0}
      accion: 12
      parametro: 0
    - hablante: 1
      texto: Estoy bien. Sigo en pie.
      retrato: {fileID: 0}
      accion: 10
      parametro: 0
    - hablante: 1
      texto: "Aprend\xED de la mejor, profe. Ahora terminemos."
      retrato: {fileID: 0}
      accion: 1
      parametro: 3
  - nombre: 'Ruptura: el ultimo de Julieta'
    fase: 3
    cualquierFase: 0
    cuando:
    - cuando: 5
      valor: 0
    lineas:
    - hablante: 0
      texto: Me queda uno, {PJ}. Y no lo pienso soltar.
      retrato: {fileID: 0}
      accion: 0
      parametro: 0
  - nombre: 'Ruptura: Nestor acompana'
    fase: 3
    cualquierFase: 0
    cuando:
    - cuando: 2
      valor: 2
    lineas:
    - hablante: 2
      texto: "Ella nunca perdi\xF3 un turno en su vida, {PJ}. Que este sea el primero."
      retrato: {fileID: 21300000, guid: 8ce26824c4e18f74aa1d4a5ea277d149, type: 3}
      accion: 0
      parametro: 0
  alPerder:
  - hablante: 0
    texto: "Esto es lo que te quer\xEDa mostrar, {PJ}. Sin mis reglas no hay juego."
    retrato: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "Tu equipo vuelve a como entr\xF3. No me sirve de nada ganarle a alguien
      roto."
    retrato: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "Cuando quieras, volv\xE9 a intentarlo. Yo no me voy a ning\xFAn lado."
    retrato: {fileID: 0}
    accion: 0
    parametro: 0
  finalDelJuego:
  - hablante: 3
    texto: 'NEURARUSH-LINK: ADMINISTRADORA DESCONECTADA.'
    retrato: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 3
    texto: "MEWTWO: CONEXI\xD3N PERDIDA. HOOPA: CONEXI\xD3N PERDIDA."
    retrato: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: ...
    retrato: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "Se termin\xF3."
    retrato: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: "\xBFPor qu\xE9, Julieta? \xBFPor qu\xE9 todo esto?"
    retrato: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "Porque vi a mis alumnos equivocarse durante a\xF1os. Olvidarse todo al
      otro d\xEDa del examen. Quedarse atr\xE1s."
    retrato: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "El LINK iba a arreglar eso. Nadie m\xE1s se iba a quedar atr\xE1s."
    retrato: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: "Nadie se iba a quedar atr\xE1s porque nadie se iba a poder mover."
    retrato: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "Cuando se abri\xF3 el portal, el mundo se rompi\xF3. Alguien ten\xEDa
      que escribir las reglas nuevas."
    retrato: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: Si no era yo, no iba a ser nadie.
    retrato: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: "Hab\xEDa que dejar que la gente se equivoque. Eso tambi\xE9n es aprender."
    retrato: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: "Lo dice el que quer\xEDa voltear la red del colegio por venganza."
    retrato: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 1
    texto: "S\xED. Y mir\xE1: mi virus termin\xF3 sirviendo para algo."
    retrato: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: ...
    retrato: {fileID: 0}
    accion: 0
    parametro: 0
  - hablante: 0
    texto: Aprobado, {PJ}.
