  m_Script: {fileID: 11500000, guid: a0f91ab8d2ed2e846b7d97bd368fc013, type: 3}
  m_Name: Casino_Reymar_Antes
  m_EditorClassIdentifier: Assembly-CSharp::DialogueDefinition
  speakerName: REYMAR
  speakerPortrait: {fileID: 21300000, guid: 97358298e5121c8408cf32d53e1270c9, type: 3}
  lines:
  - "[PJ] \xBFJulieta lo sab\xEDa?"
  - "[REYMAR] S\xED."
  - "[PJ] \xBFY por eso me dej\xF3 vivo?"
  - '[REYMAR] No.'
  - "[PJ] \xBFEntonces?"
  - "[REYMAR] Porque quer\xEDa repetir el experimento."
  - "[PJ] \xBFY qu\xE9 tiene que ver el servidor?"
  - '[REYMAR] El servidor guarda los datos de todos los experimentos.'
  - "[PJ] Entonces ah\xED est\xE1 mi informaci\xF3n."
  - '[REYMAR] Toda.'
  - '[PJ] Entonces voy a entrar.'
  - '[REYMAR] No.'
  - "[PJ] \xBFPor qu\xE9?"
  - "[REYMAR] Porque si destru\xEDs este servidor..."
  - '[] Reymar mira las pantallas.'
  - '[REYMAR] ...todos esos datos van a desaparecer.'
  - "[PJ] \xBFY eso ser\xEDa malo?"
  - "[REYMAR] Para vos, s\xED."
  - "[PJ] \xBFPor qu\xE9?"
  - "[REYMAR] Porque probablemente sea la \xFAnica forma de descubrir qu\xE9 te hicieron."
  - '[] Silencio.'
  - '[PJ] Entonces dejame pasar.'
  - '[REYMAR] No puedo.'
  - "[PJ] \xBFNo quer\xE9s?"
  - '[REYMAR] No puedo.'
  - "[PJ] \xBFPor qu\xE9?"
  - "[REYMAR] Porque el sistema todav\xEDa me reconoce como uno de sus administradores."
  - '[] Reymar te muestra su nuca. Su NeuraRush-LINK comienza a iluminarse.'
  - '[REYMAR] Y mientras siga conectado... tengo que protegerlo.'
  - "[PJ] Entonces supongo que vamos a tener que arreglarlo a las pi\xF1as..."
