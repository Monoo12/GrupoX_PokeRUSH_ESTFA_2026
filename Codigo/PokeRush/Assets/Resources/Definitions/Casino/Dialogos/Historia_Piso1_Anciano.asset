  m_Script: {fileID: 11500000, guid: a0f91ab8d2ed2e846b7d97bd368fc013, type: 3}
  m_Name: Historia_Piso1_Anciano
  m_EditorClassIdentifier: Assembly-CSharp::DialogueDefinition
  speakerName: "ANCIANO"
  speakerPortrait: {fileID: 0}
  lines:
  - "[ANCIANO] Llevo cuarenta a\xF1os viniendo a este casino. Bueno, treinta y cinco."
  - "[ANCIANO] De los \xFAltimos cinco no me acuerdo si vine... o si nunca me fui."
  - "[ANCIANO] Dicen que el due\xF1o nunca baja de la oficina del \xFAltimo piso. Y que el ascensor no sube hasta ah\xED: te lleva."
  - "[ANCIANO] Hace a\xF1os vi por la ventana un aro dorado, enorme, flotando arriba del Ameghino. Esa noche nadie gan\xF3 ni perdi\xF3."
  - "[ANCIANO] Un consejo de viejo: en el tercer piso hay un empresario que vende tiros de ruleta."
  - "[ANCIANO] Cobra caro, pero su ruleta siempre da un Pok\xE9mon. Lleg\xE1 arriba con el equipo lleno."
  - "[ANCIANO] Si lleg\xE1s hasta arriba, despu\xE9s contame c\xF3mo es."
  requiredFlag: 0
  grantsFlag: 0
