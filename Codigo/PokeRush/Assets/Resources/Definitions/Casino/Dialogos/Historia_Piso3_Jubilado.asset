  m_Script: {fileID: 11500000, guid: a0f91ab8d2ed2e846b7d97bd368fc013, type: 3}
  m_Name: Historia_Piso3_Jubilado
  m_EditorClassIdentifier: Assembly-CSharp::DialogueDefinition
  speakerName: JUBILADO
  speakerPortrait: {fileID: 0}
  lines:
  - "Yo antes ten\xEDa un equipo entero. Se lo apost\xE9 a Tacconi, uno por uno."
  - "Dicen que el due\xF1o del casino le presta los Pok\xE9mon raros para que los
    apueste."
  - "Si le gan\xE1s, no le digas a nadie c\xF3mo lo hiciste."
