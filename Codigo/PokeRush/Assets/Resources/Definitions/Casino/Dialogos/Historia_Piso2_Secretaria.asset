  m_Script: {fileID: 11500000, guid: a0f91ab8d2ed2e846b7d97bd368fc013, type: 3}
  m_Name: Historia_Piso2_Secretaria
  m_EditorClassIdentifier: Assembly-CSharp::DialogueDefinition
  speakerName: "SECRETARIA"
  speakerPortrait: {fileID: 0}
  lines:
  - "[SECRETARIA] Trabajo en la administraci\xF3n del casino desde hace a\xF1os. No me preguntes cu\xE1ntos: el chip no me lo dice."
  - "[SECRETARIA] El ascensor tiene un bot\xF3n de piso 4. Lo que hay arriba decide qui\xE9n gana y qui\xE9n pierde."
  - "[SECRETARIA] Pero eso no te lo dije yo."
  requiredFlag: 0
  grantsFlag: 0
  otrosHablantes: []
  variantes:
  - nota: "Si hablo con su hermano en el Data Center"
    requiere: 74
    requiereTambien: 0
    excluye: 0
    lineas:
    - "[SECRETARIA] Trabajo en la administraci\xF3n del casino. ...Esper\xE1. Ten\xE9s olor a data center. Ozono y caf\xE9 fr\xEDo."
    - "[PJ] Conoc\xED a tu hermano. Trabaja en el Servidor 01."
    - "[SECRETARIA] \xBFLo viste? \xBFEst\xE1 bien?"
    - "[PJ] Est\xE1 bien. Habla mucho de vos."
    - "[SECRETARIA] ...Hace cinco a\xF1os que no me acuerdo de su voz. Y ahora me acuerdo. Qu\xE9 raro."
    - "[SECRETARIA] Te voy a decir algo que no te puedo decir: lo que hay en el piso 4 decide qui\xE9n gana y qui\xE9n pierde."
    - "[SECRETARIA] Pero eso no te lo dije yo."
    otorgaFlag: 0
  otorgaObjeto: {fileID: 0}
