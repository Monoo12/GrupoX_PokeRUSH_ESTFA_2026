  speakerName: "GUARDIA"
  speakerPortrait: {fileID: 0}
  lines:
  - "[GUARDIA] Arriba no se sube. Adentro no se entra. Vos ya est\xE1s adentro, as\xED que segu\xED."
  - "[GUARDIA] El jefe te est\xE1 esperando. No hagas nada raro."
  requiredFlag: 0
  grantsFlag: 0
  otrosHablantes: []
  variantes:
  - nota: "Si hablo con la mujer de las tragamonedas"
    requiere: 80
    requiereTambien: 0
    excluye: 0
    lineas:
    - "[GUARDIA] Una se\xF1ora de las tragamonedas avis\xF3 que andaba alguien sin chip."
    - "[GUARDIA] Baj\xF3 la orden de dejarte subir. Rara orden. Pero ac\xE1 las \xF3rdenes no se discuten."
