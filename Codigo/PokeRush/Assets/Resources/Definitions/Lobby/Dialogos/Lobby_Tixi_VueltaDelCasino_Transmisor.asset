  m_Script: {fileID: 11500000, guid: a0f91ab8d2ed2e846b7d97bd368fc013, type: 3}
  m_Name: Lobby_Tixi_VueltaDelCasino_Transmisor
  m_EditorClassIdentifier: Assembly-CSharp::DialogueDefinition
  speakerName: TIXI
  speakerPortrait: {fileID: 21300000, guid: 29f022df382dcbf47a02f8d6628d92f5, type: 3}
  lines:
  - '[SISTEMA] OBJETO OBTENIDO: TRANSMISOR DE TIXI.'
  - "[TIXI] Es un transmisor. Si consegu\xEDs llegar al servidor, voy a poder conectarme
    desde ac\xE1 e intentar abrirte el acceso."
  - "[PJ] \xBFY si no funciona?"
  - "[TIXI] Improvis\xE1s. Parece que se te da bastante bien."
  - '[PJ] Gracias por la confianza.'
  - "[TIXI] Y una \xFAltima cosa..."
  - "[PJ] \xBFQu\xE9?"
  - "[TIXI] Cuando encuentres a Julieta, preguntale qu\xE9 pas\xF3 realmente en 2026."
  - "[PJ] \xBFNo lo sab\xE9s?"
  - "[TIXI] S\xE9 lo que dicen los registros. Pero hay demasiadas cosas que no encajan."
  - "[PJ] Entonces voy a pregunt\xE1rselo personalmente."
  - '[TIXI] Buena suerte, {PJ}.'
  - '[PJ] Nos vemos a la vuelta.'
  - "[TIXI] M\xE1s te vale."
  - '[SISTEMA] NUEVO OBJETIVO: LLEGAR A LA SEDE CENTRAL DE LA LIGA.'
  - "[SISTEMA] \xDALTIMO SERVIDOR DETECTADO. UBICACI\xD3N: AMEGHINO."
