  m_Script: {fileID: 11500000, guid: a0f91ab8d2ed2e846b7d97bd368fc013, type: 3}
  m_Name: Lobby_Tixi_VueltaDelCasino_Central
  m_EditorClassIdentifier: Assembly-CSharp::DialogueDefinition
  speakerName: "TIXI"
  speakerPortrait: {fileID: 21300000, guid: 2b17330598b96a5459868a2f61a48db0, type: 3}
  lines:
  - "[] En el mapa, los dos servidores que quedan parpadean. Sale una l\xEDnea de cada uno... y las dos terminan en el mismo punto."
  - "[TIXI] \xBFVes eso? Desde que cayeron los dos primeros, los otros mandan todo su tr\xE1fico a un lugar que no figuraba en ning\xFAn mapa."
  - "[TIXI] El servidor central."
  - "[PJ] Ah\xED est\xE1 ella."
  - "[TIXI] Ah\xED est\xE1 ella."
  - "[] Un mensaje aparece solo en la pantalla, sin remitente:"
  - "[SISTEMA] print(\"Buen trabajo. Te espero. -J.\")"
  - "[TIXI] ...Us\xF3 mi formato. Con print() y todo."
  - "[PJ] Te est\xE1 copiando."
  - "[TIXI] No. Me est\xE1 avisando que ley\xF3 mi carta."
  - "[TIXI] Todav\xEDa no puedo abrirte un camino hasta ah\xED. Descans\xE1. Cuando lo tenga, te aviso."
