  m_Script: {fileID: 11500000, guid: a0f91ab8d2ed2e846b7d97bd368fc013, type: 3}
  m_Name: Lobby_Martin_Charla
  m_EditorClassIdentifier: Assembly-CSharp::DialogueDefinition
  speakerName: "MART\xCDN"
  speakerPortrait: {fileID: 21300000, guid: 97358298e5121c8408cf32d53e1270c9, type: 3}
  lines:
  - "[MART\xCDN] Nunca nadie me hab\xEDa ganado en mi propia mesa."
  - "[MART\xCDN] Cinco a\xF1os girando una ruleta. \xBFSab\xE9s qu\xE9 descubr\xED cuando se me apag\xF3 el chip? Que nunca la gir\xE9 yo."
  - "[MART\xCDN] Los n\xFAmeros ven\xEDan de arriba. Del servidor. Yo solo pon\xEDa la cara."
  - "[MART\xCDN] As\xED que me traje las ruletas. Ac\xE1 las giro yo. La casa tambi\xE9n gana... casi siempre."
