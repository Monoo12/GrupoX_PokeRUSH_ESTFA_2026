  m_Script: {fileID: 11500000, guid: a0f91ab8d2ed2e846b7d97bd368fc013, type: 3}
  m_Name: Camino_Inicio
  m_EditorClassIdentifier: Assembly-CSharp::DialogueDefinition
  speakerName: ""
  speakerPortrait: {fileID: 0}
  lines:
  - "[] Afuera, la ciudad est\xE1 en silencio. Demasiado silencio para ser de d\xEDa."
  - "[] En cada ventana brilla una c\xE1psula. Adentro, gente durmiendo con los ojos abiertos."
  - "[] Un Lillipup con un chip en la nuca camina en l\xEDnea recta hasta chocar con un poste. Gira noventa grados y sigue."
  - "[] Un Pidgey mira un cartel de la Liga sin pesta\xF1ear: \"DORM\xCD TRANQUILO. NOSOTROS PENSAMOS POR VOS.\""
  - "[] En la esquina hay alguien con casco del Gobierno Mundial. Al lado, un robotito que no para de hablar."
  - "[] Esa cara te suena."
  - "[PJ] \xBF...CRUZ?"
  - "[CRUZ] \xBFQu\xE9 hac\xE9s fuera de tu c\xE1psula? \xA1Present\xE1 respetos al Gobierno Mundial!"
  - "[ARTURITO] Bip. Ciudadano fuera de horario. Bip. Qu\xE9 verg\xFCenza. Bip."
  requiredFlag: 0
  grantsFlag: 66
  otrosHablantes:
  - nombre: "CRUZ"
    retrato: {fileID: 21300000, guid: bb83d80bef73aff4eafbf0dd6154a5a9, type: 3}
  - nombre: "ARTURITO"
