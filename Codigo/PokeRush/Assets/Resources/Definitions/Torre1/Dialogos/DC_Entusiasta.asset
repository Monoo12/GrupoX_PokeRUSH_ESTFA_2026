  m_Script: {fileID: 11500000, guid: a0f91ab8d2ed2e846b7d97bd368fc013, type: 3}
  m_Name: DC_Entusiasta
  m_EditorClassIdentifier: Assembly-CSharp::DialogueDefinition
  speakerName: "ENTUSIASTA"
  speakerPortrait: {fileID: 0}
  lines:
  - "[ENTUSIASTA] \xBFNo es maravilloso? Anoche aprend\xED redes durante una siesta. Toda la teor\xEDa. De una."
  - "[ENTUSIASTA] \xBFVos cu\xE1nto tardaste? \xBFCuatro a\xF1os de colegio? Qu\xE9 antiguo."
  - "[ENTUSIASTA] La Directora dice que equivocarse es una p\xE9rdida de tiempo. Y la Directora nunca se equivoca."
  - "[ENTUSIASTA] ...Igual es raro. A veces me despierto sabiendo cosas que no me acuerdo de haber querido aprender."
  requiredFlag: 0
  grantsFlag: 0
  otrosHablantes: []
  variantes:
  - nota: "Con el servidor caido"
    requiere: 78
    requiereTambien: 0
    excluye: 0
    lineas:
    - "[ENTUSIASTA] Se cort\xF3. Estaba aprendiendo alem\xE1n y se cort\xF3 en la mitad de una palabra."
    - "[ENTUSIASTA] Y lo que ya hab\xEDa aprendido tambi\xE9n se fue. No me queda nada. Ni el alem\xE1n ni las redes."
    - "[ENTUSIASTA] \xBFEra as\xED? \xBFEl LINK no nos ense\xF1aba nada? \xBFSolo nos lo prestaba?"
    otorgaFlag: 0
  otorgaObjeto: {fileID: 0}
  pregunta: ""
  respuestas: []
  cancelarElige: -1
  siguiente: {fileID: 0}
