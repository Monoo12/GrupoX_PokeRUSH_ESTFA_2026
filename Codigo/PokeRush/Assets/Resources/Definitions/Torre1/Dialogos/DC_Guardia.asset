  m_Script: {fileID: 11500000, guid: a0f91ab8d2ed2e846b7d97bd368fc013, type: 3}
  m_Name: DC_Guardia
  m_EditorClassIdentifier: Assembly-CSharp::DialogueDefinition
  speakerName: "GUARDIA"
  speakerPortrait: {fileID: 21300000, guid: d67ba901590278c4eba4add4f31526e1, type: 3}
  lines:
  - "[GUARDIA] Alto. Zona de control. \xBFTen\xE9s autorizaci\xF3n?"
  - "[SISTEMA] AVISO A SEGURIDAD: USUARIO SIN CHIP DETECTADO EN EL SECTOR C."
  - "[GUARDIA] Recibido."
  - "[] El guardia te mira de arriba abajo. A vos. En el sector C."
  - "[GUARDIA] \xBFViste a alguien sin chip por ac\xE1?"
  - "[PJ] No."
  - "[GUARDIA] Bien. Si ves a alguien, avis\xE1."
  requiredFlag: 0
  grantsFlag: 0
  otrosHablantes: []
  variantes:
  - nota: "Con el servidor caido"
    requiere: 78
    requiereTambien: 0
    excluye: 0
    lineas:
    - "[GUARDIA] Recib\xED una \xFAltima orden: \"No conf\xEDen en nadie que no tenga chip\". Despu\xE9s, nada. Silencio."
    - "[GUARDIA] Es la primera vez en cinco a\xF1os que nadie me dice qu\xE9 hacer."
    - "[GUARDIA] ...\xBFVos sab\xE9s qu\xE9 se hace un martes a la tarde?"
    otorgaFlag: 0
  - nota: "Ya recibio la orden"
    requiere: 75
    requiereTambien: 0
    excluye: 0
    lineas:
    - "[GUARDIA] Sigo buscando a alguien sin chip. Si lo ves, avis\xE1."
    - "[GUARDIA] Vos no, obvio. Vos sos de ac\xE1."
    otorgaFlag: 0
  otorgaObjeto: {fileID: 0}
