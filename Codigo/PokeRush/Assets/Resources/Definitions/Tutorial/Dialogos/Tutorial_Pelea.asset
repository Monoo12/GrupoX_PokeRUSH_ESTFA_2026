  m_Script: {fileID: 11500000, guid: a0f91ab8d2ed2e846b7d97bd368fc013, type: 3}
  m_Name: Tutorial_Pelea
  m_EditorClassIdentifier: Assembly-CSharp::DialogueDefinition
  speakerName: REBECA
  speakerPortrait: {fileID: 21300000, guid: 1575ff0858080f14b8a6a30f2f005ff0, type: 3}
  lines:
  - "[REBECA] \xA1Por fin! Mi chip me avis\xF3 que hab\xEDa movimiento en tu c\xE1psula."
  - "[PJ] \xBFMi qu\xE9? ...Par\xE1. \xBFVos no ibas al Ameghino conmigo?"
  - "[REBECA] \xBFAl qu\xE9? El chip no tiene nada con ese nombre. As\xED que no."
  - "[REBECA] Rutina de la Liga: todo ciudadano despierto hace una pelea de pr\xE1ctica. Yo solo repito lo que dice el chip."
  - "[REBECA] LUCHAR: eleg\xEDs un movimiento. Al lado de cada uno ves su tipo, sus PP, su potencia y su precisi\xF3n."
  - "[REBECA] Y fijate la tabla de tipos: el Agua apaga el Fuego, el Fuego quema la Planta y la Planta absorbe el Agua."
  - "[REBECA] Si tu ataque le gana al tipo del rival pega el doble: es s\xFAper eficaz. Si pierde, pega la mitad."
  - "[REBECA] Y hay tipos que ni se tocan: lo El\xE9ctrico no le hace nada a la Tierra. Pens\xE1 contra qu\xE9 pele\xE1s antes de pegar."
  - "[REBECA] MOCHILA: us\xE1s un objeto, pero se te va el turno. POK\xC9MON: cambi\xE1s al que pelea. HUIR: solo contra salvajes."
  - "[REBECA] Si perd\xE9s no pasa nada: te curo y probamos de nuevo. \xA1Vamos!"
  requiredFlag: 0
  grantsFlag: 0
  otrosHablantes: []
  variantes: []
  otorgaObjeto: {fileID: 0}
  pregunta: ""
  respuestas: []
  cancelarElige: -1
  siguiente: {fileID: 0}
