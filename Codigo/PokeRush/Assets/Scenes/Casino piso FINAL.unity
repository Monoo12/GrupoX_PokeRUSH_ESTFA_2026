  m_Script: {fileID: 11500000, guid: 8567d652d0dfe0f4394e830d4a63c736, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CasinoJefeFinalNpc
  battleController: {fileID: 0}
  dialogueController: {fileID: 0}
  nombre: REYMAR
  retrato: {fileID: 21300000, guid: 97358298e5121c8408cf32d53e1270c9, type: 3}
  mensajeSinEquipo: "Con el equipo as\xED no se puede pelear. Pas\xE1 por la enfermer\xEDa."
  rival: {fileID: 11400000, guid: 87a2f93ddf4a4574ea2ea33d2ebbc734, type: 2}
  flagVencido: 49
  flagCasinoCompletado: 50
  ruletaDeCombate: {fileID: 11400000, guid: 2ed15e33517ba3641801e431aeeaf600, type: 2}
  turnosEntreGiros: 2
  maximoDeRevanchas: 1
  mensajeDeEncuentro: "Sentate. Ac\xE1 arriba las peleas las reparte la casa: cada
    dos turnos, la ruleta decide por vos."
  mensajeYaVencido: "Te llevaste el casino entero. And\xE1 antes de que cambie de
    idea."
  mensajePerdisteLaPelea: "Te gan\xE9. Pero la casa no te deja ir sin revancha: una
    mano. Si gan\xE1s, uno de tus Pok\xE9mon se levanta y seguimos."
  mensajeGanasteLaPelea: "Me ganaste... pero ac\xE1 todav\xEDa se juega. Una mano.
    Si te gano, uno de los m\xEDos se levanta y seguimos."
  mensajeSinRevancha: Se acabaron las manos. La casa cierra.
  mensajeRevivesEntero: "\xA1{0} se levanta como nuevo! Dale, seguimos."
  mensajeRevivesAMedias: "Empate. {0} se levanta, pero a media m\xE1quina. Seguimos."
  mensajeJefeRevive: "\xBFViste? La casa siempre tiene una carta m\xE1s. {0} vuelve
    a la mesa."
  mensajeJefeReviveAMedias: "Empate. {0} vuelve, aunque sea a media m\xE1quina."
  mensajeVictoria: "Se termin\xF3. El casino es tuyo. And\xE1 a contarlo."
  mensajeDerrota: "Volv\xE9 cuando tengas con qu\xE9. La mesa te espera."
