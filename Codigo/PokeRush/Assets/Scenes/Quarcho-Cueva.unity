  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::QuarchoNestorNpc
  dialogueController: {fileID: 0}
  nombre: "N\xC9STOR"
  retrato: {fileID: 21300000, guid: 853498d5f00c6fa45a5a2b62a53fa1c5, type: 3}
  charla: {fileID: 11400000, guid: dca50af70515675458610170fed19bb1, type: 2}
  precios:
    estado: 800
    debil: 600
    medio: 1000
    fuerte: 1500
    muyFuerte: 2000
    desdeMedio: 60
    desdeFuerte: 90
    desdeMuyFuerte: 110
  saludo: "\xBFQu\xE9 hacemos? Por unas monedas le ense\xF1o una MT a cualquiera
    de tus Pok\xE9mon."
  opcionEnsenar: "Ense\xF1ar una MT"
  opcionCharlar: Charlar
  opcionNada: Nada
  preguntaQuien: "\xBFA qui\xE9n le ense\xF1o?"
  mensajeSinEquipo: "No ten\xE9s ning\xFAn Pok\xE9mon para entrenar."
  mensajeSinCharla: Estar de este lado de la pelea me sienta bien.
  mensajeDespues: '{0} ya domina {1}. Cuando quieras, otra.'
  mensajeSinAprender: "Cuando te decidas, ac\xE1 estoy."
