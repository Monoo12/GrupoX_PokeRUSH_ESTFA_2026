MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 736607557}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3aee9959d7eea1046b19f758dc32e874, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CasinoTacconiNpc
  dialogueController: {fileID: 0}
  nombre: TACCONI
  retrato: {fileID: 21300000, guid: 630ce5488625ef8419eb65dcd7bdcd1d, type: 3}
  flagGanado: 55
  especiePremio: {fileID: 11400000, guid: c504ad354d512284fb457de60ef1698f, type: 2}
  nivelPremio: 52
  premioShiny: 0
  pregunta: "Tres chances, una sola vez: apost\xE1s un Pok\xE9mon a una mano de blackjack.
    Si me gan\xE1s, mi {0} es tuyo. \xBFJugamos?"
  opcionJugar: Jugar
  opcionNo: Paso
  mensajeRechazo: "Cuando te animes, ac\xE1 estoy. De esta mesa no me muevo."
  mensajeEquipoChico: "Con un solo Pok\xE9mon no te juego: si perd\xE9s, te qued\xE1s
    sin equipo."
  preguntaConfirmar: "\xBFApost\xE1s a tu {0}? Si gan\xE1s, te llev\xE1s mi {1}.
    Si perd\xE9s, tu {0} se queda conmigo."
  opcionApostar: Apostar
  mensajeGanaste: "\xA1No puede ser! Tom\xE1, el {0} es tuyo... Cuidalo, eh."
  mensajeGanasteAlPc: "\xA1No puede ser! El {0} es tuyo. Como ten\xE9s el equipo
    lleno, lo mand\xE9 a tu PC ({1})."
  mensajeSinLugar: "Ganaste, pero no ten\xE9s lugar ni en el equipo ni en el PC.
    Hac\xE9 lugar y volv\xE9: la apuesta queda en pie."
  mensajePerdiste: Tacconi siempre gana. Tu {0} se queda conmigo.
  mensajeEmpate: "Empate. Esa no cuenta: la chance sigue en pie. \xBFOtra?"
  mensajeSeFue: "\xBFTe arrepentiste? Mejor para vos."
  mensajeYaGanado: Ya te llevaste mi {0}. Un trato es un trato.
  presentacion: {fileID: 11400000, guid: f7d83c0b91ef54577d8d663060b12afe, type: 2}
  despuesDeGanar: {fileID: 0}
  charlaYaGanado: {fileID: 0}
  chances: 340000003500000036000000
  mensajeSinChances: Ya tuviste tus {0} chances. Tacconi no vuelve a jugar con vos.
  mensajeChancesQueQuedan: Te quedan {0} chances.
  mensajeUltimaChance: "Era tu \xFAltima chance."
