  - {fileID: 21300000, guid: 7620c18aaa1103a4cbb9d0cac7c4e2da, type: 3}
  - {fileID: 21300000, guid: 21865a132bb0f5b41bb3fa9fca76c45b, type: 3}
  - {fileID: 21300000, guid: 15269c0a740e8124a932a4a139b67ef3, type: 3}
  - {fileID: 21300000, guid: 5ca777ada49759246ba38e9e6fc5be35, type: 3}
  - {fileID: 21300000, guid: b0d7aff3d99b13744b8cc374d1e022e2, type: 3}
  iaDeLosPrimeros: {fileID: 11400000, guid: b45cec9649f49d543a98946e5e8f48e2, type: 2}
  iaDelMedio: {fileID: 11400000, guid: e4e7bcb582789584a88898f642a0d19d, type: 2}
  iaDeLosUltimos: {fileID: 11400000, guid: 0bd02e502ab2eec4ea3a823281291e4a, type: 2}
  explicacion:
  - "El chip te conecta a una simulaci\xF3n: entrenadores virtuales, uno detr\xE1s
    de otro, con tres Pok\xE9mon cada uno."
  - "Antes de cada combate te curo el equipo. Cada victoria paga m\xE1s que la anterior;
    si perd\xE9s, se corta la racha."
  preguntaEntrar: "\xBFTe conecto? El primer combate paga {0} monedas."
  opcionEntrar: Conectarme
  opcionNoEntrar: Ahora no
  antesDelCombate: "Simulaci\xF3n {0}: un entrenador virtual te desaf\xEDa."
  preguntaSeguir: "\xA1Racha de {0}! El pr\xF3ximo combate paga {1}. \xBFSegu\xEDs?"
  opcionSeguir: Seguir
  opcionRetirarse: Retirarme
  mensajeRetiro: "Te desconecto con una racha de {0}. Ganaste {1} monedas en total
    y tu equipo qued\xF3 curado."
  mensajeDerrota: "La simulaci\xF3n te gan\xF3 en el combate {0}. Te qued\xE1s con
    las {1} monedas que ganaste. Tu equipo qued\xF3 curado."
  mensajeDerrotaSinPremio: "La simulaci\xF3n te gan\xF3 de entrada. Tu equipo qued\xF3
    curado: prob\xE1 de nuevo cuando quieras."
  mensajeSinCombate: "El chip no puede armar la simulaci\xF3n ahora. Prob\xE1 m\xE1s
    tarde."
