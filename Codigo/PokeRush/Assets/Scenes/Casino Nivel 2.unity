  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CasinoTrainerNpc
  battleController: {fileID: 0}
  dialogueController: {fileID: 0}
  nombre: BAILARINA
  retrato: {fileID: 21300000, guid: 1575ff0858080f14b8a6a30f2f005ff0, type: 3}
  mensajeSinEquipo: "Con el equipo as\xED no se puede pelear. Pas\xE1 por la enfermer\xEDa."
  rival: {fileID: 11400000, guid: d97de1892c8dbb947a2af1d400068d0f, type: 2}
  flagVencido: 45
  ruleta: {fileID: 11400000, guid: 96a5a8a782ae304458a337c134282f2b, type: 2}
  objetoAlGanar: {fileID: 0}
  mensajeObjeto: "Tom\xE1, te la ganaste: la {0} es tuya."
  pregunta: "Mi n\xFAmero empieza en diez minutos. \xBFMe ayud\xE1s a calentar con
    una pelea?"
  opcionSi: Dale
  opcionNo: Ahora no
  mensajeSiRechaza: Bueno, bailo sola.
  mensajeVictoria: "\xA1Qu\xE9 ritmo ten\xE9s! Me ganaste."
  mensajeRuleta: "Y encima te toca la ruleta de premios. \xA1Gir\xE1!"
  mensajeDerrota: 
  mensajeYaVencido: Ya me ganaste. Ahora, a bailar.
