  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CasinoTrainerNpc
  battleController: {fileID: 0}
  dialogueController: {fileID: 0}
  nombre: "M\xC9DIUM"
  retrato: {fileID: 21300000, guid: c84b04f3f9c37a048ae6817f7b3f5492, type: 3}
  mensajeSinEquipo: "Con el equipo as\xED no se puede pelear. Pas\xE1 por la enfermer\xEDa."
  rival: {fileID: 11400000, guid: 7e23ddf9aa35d3f45a7b04df49a7f6db, type: 2}
  flagVencido: 35
  ruleta: {fileID: 11400000, guid: 96a5a8a782ae304458a337c134282f2b, type: 2}
  objetoAlGanar: {fileID: 0}
  mensajeObjeto: "Tom\xE1, te la ganaste: la {0} es tuya."
  pregunta: "Las cartas me dijeron que ibas a venir. Tambi\xE9n dicen que vas a perder.
    \xBFProbamos?"
  opcionSi: Probemos
  opcionNo: No
  mensajeSiRechaza: "Ya lo sab\xEDa."
  mensajeVictoria: Esto no estaba en las cartas.
  mensajeRuleta: "Y encima te toca la ruleta de premios. \xA1Gir\xE1!"
  mensajeDerrota: 
  mensajeYaVencido: Las cartas no me hablan desde que me ganaste.
