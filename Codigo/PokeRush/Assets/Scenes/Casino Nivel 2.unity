  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CasinoTrainerNpc
  battleController: {fileID: 0}
  dialogueController: {fileID: 0}
  nombre: "LADR\xD3N"
  retrato: {fileID: 21300000, guid: a98cd53a01fd21045a2e01f59a4da861, type: 3}
  mensajeSinEquipo: "Con el equipo as\xED no se puede pelear. Pas\xE1 por la enfermer\xEDa."
  rival: {fileID: 11400000, guid: 2bb553c55144ede488f48505e342f4a2, type: 2}
  flagVencido: 36
  ruleta: {fileID: 11400000, guid: 96a5a8a782ae304458a337c134282f2b, type: 2}
  objetoAlGanar: {fileID: 0}
  mensajeObjeto: "Tom\xE1, te la ganaste: la {0} es tuya."
  pregunta: "Shh... nadie vio nada. Si me gan\xE1s, no te toco las fichas. \xBFTrato?"
  opcionSi: Trato
  opcionNo: Ni loco
  mensajeSiRechaza: "Cuid\xE1 tus bolsillos."
  mensajeVictoria: "Est\xE1 bien, est\xE1 bien. Tus fichas est\xE1n a salvo."
  mensajeRuleta: "Y encima te toca la ruleta de premios. \xA1Gir\xE1!"
  mensajeDerrota: 
  mensajeYaVencido: Yo no fui. Ni me mires.
