  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CasinoTrainerNpc
  battleController: {fileID: 0}
  dialogueController: {fileID: 0}
  nombre: "TAH\xDAR"
  retrato: {fileID: 21300000, guid: 60ed38f5a3e4a61419ff5a54568df8ef, type: 3}
  mensajeSinEquipo: "Con el equipo as\xED no se puede pelear. Pas\xE1 por la enfermer\xEDa."
  rival: {fileID: 11400000, guid: 6ac9e72001c53da46b296efc074b751d, type: 2}
  flagVencido: 44
  ruleta: {fileID: 11400000, guid: 96a5a8a782ae304458a337c134282f2b, type: 2}
  objetoAlGanar: {fileID: 0}
  mensajeObjeto: "Tom\xE1, te la ganaste: la {0} es tuya."
  pregunta: "Las ruletas est\xE1n arregladas, pero una pelea no. \xBFProbamos suerte?"
  opcionSi: Probemos
  opcionNo: No
  mensajeSiRechaza: Cobarde.
  mensajeVictoria: Me limpiaste. Ni en la ruleta pierdo tanto.
  mensajeRuleta: "Y encima te toca la ruleta de premios. \xA1Gir\xE1!"
  mensajeDerrota: 
  mensajeYaVencido: "Ya me ganaste. And\xE1 a apostar lo que me sacaste."
