  retrato: {fileID: 21300000, guid: bb83d80bef73aff4eafbf0dd6154a5a9, type: 3}
  objeto: {fileID: 11400000, guid: 067a7cc907524964883a11796fc45e9a, type: 2}
  precio: 1500
  pregunta: "Pst... \xBFbusc\xE1s la {0}? Te la dejo en {1} monedas. \xBFHay trato?"
  opcionComprar: Comprar
  opcionNo: No
  mensajeSinPlata: "\xBFLa {0}? Son {1} monedas y ten\xE9s {2}. Volv\xE9 cuando tengas
    la plata."
  mensajeVendido: "Un placer. La {0} es tuya: al guardia del ascensor no le va a
    importar de d\xF3nde la sacaste."
  mensajeRechazo: "Vos te lo perd\xE9s. Ac\xE1 voy a estar."
  mensajeYaLoTiene: "Ya ten\xE9s la {0}. No hagas esperar al guardia."
