  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CasinoElevatorGuard
  battleController: {fileID: 0}
  dialogueController: {fileID: 0}
  nombre: GUARDIA VIP
  retrato: {fileID: 21300000, guid: 1c67032061d8cb34681a045aad61da63, type: 3}
  mensajeSinEquipo: "Con el equipo as\xED no se puede pelear. Pas\xE1 por la enfermer\xEDa."
  flagPase: 41
  precio: 0
  objetoRequerido: {fileID: 11400000, guid: 067a7cc907524964883a11796fc45e9a, type: 2}
  rival: {fileID: 11400000, guid: 8c658b6e8013c794180308af67126b51, type: 2}
  flagVencido: 42
  ruletaDePokemon: {fileID: 11400000, guid: db23dbc5fdc337648a9f6ee0fd871edb, type: 2}
  preguntaPagar: "Para subir se paga: {0} monedas. \xBFMe las das?"
  opcionPagar: Pagar {0}
  opcionNoPagar: No
  preguntaPelearSinPlata: "Para subir son {0} monedas y ten\xE9s {1}. Si no pag\xE1s,
    ganame una pelea. \xBFTe anim\xE1s?"
  preguntaPelear: "Entonces ganame una pelea y te dejo pasar gratis. \xBFTe anim\xE1s?"
  opcionPelear: Pelear
  opcionNoPelear: "Todav\xEDa no"
  mensajeRechazo: "Sin pagar o ganarme, de ac\xE1 no sub\xEDs."
  mensajePagado: Trato hecho. El ascensor es todo tuyo.
  mensajeVictoria: "Bien jugado. Pas\xE1... y llevate un premio de la casa."
  mensajeRuleta: "Gir\xE1 la ruleta: lo que salga, es tuyo."
  mensajeDerrota: "As\xED no sub\xEDs. Volv\xE9 cuando quieras, o pagame."
  mensajeYaTienePase: "Ya ten\xE9s el pase. Adelante."
  mensajeMuestraObjeto: "\xBFLa {0}? Pas\xE1, pas\xE1. El ascensor es todo tuyo."
  preguntaPelearSinObjeto: "Arriba solo suben los que tienen la {0}. Si no la ten\xE9s,
    ganame una pelea. \xBFTe anim\xE1s?"
  mensajeRechazoSinObjeto: "Sin la {0} no sub\xEDs. Dicen que se consigue en este
    mismo piso."
