  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CasinoTrainerNpc
  battleController: {fileID: 0}
  dialogueController: {fileID: 0}
  nombre: JOVEN RICA
  retrato: {fileID: 21300000, guid: 9e3bb7c6c3c013d49923c9929098eeed, type: 3}
  mensajeSinEquipo: "Con el equipo as\xED no se puede pelear. Pas\xE1 por la enfermer\xEDa."
  rival: {fileID: 11400000, guid: 09f944bbddbc86b45be0ee3dac16f484, type: 2}
  flagVencido: 27
  ruleta: {fileID: 11400000, guid: 96a5a8a782ae304458a337c134282f2b, type: 2}
  objetoAlGanar: {fileID: 0}
  mensajeObjeto: "Tom\xE1, te la ganaste: la {0} es tuya."
  pregunta: "Las fichas me aburren. Una pelea de verdad me vendr\xEDa bien. \xBFAcept\xE1s?"
  opcionSi: Acepto
  opcionNo: No
  mensajeSiRechaza: "Qu\xE9 decepci\xF3n."
  mensajeVictoria: "Qu\xE9 forma tan poco elegante de ganar... pero ganaste."
  mensajeRuleta: "Y encima te toca la ruleta de premios. \xA1Gir\xE1!"
  mensajeDerrota: 
  mensajeYaVencido: "No insistas, ya perd\xED una vez."
